class GitignoreAccessor:
    def __init__(self, gitignore_path='.gitignore'):
        self.gitignore_path = gitignore_path

    def read_gitignore(self):
        try:
            with open(self.gitignore_path, 'r') as f:
                return [line.strip() for line in f.readlines()]
        except FileNotFoundError:
            print(f"Error: {self.gitignore_path} file not found")
            return []

    def get_ignored_files(self):
        ignored_files = self.read_gitignore()
        return [file for file in ignored_files if not file.startswith('#')]

